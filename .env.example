GOOGLE_API_KEY=your_key_here

# ---- Optional tuning (defaults shown) ----
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.1-flash-lite,gemini-flash-latest,gemini-2.5-flash-lite

# Speech-to-text: "whisper" (local) or "gemini" (cloud)
# STT_ENGINE=whisper
# WHISPER_MODEL=base            # tiny | base | small | medium
# AUDIO_PIECE_SECONDS=600       # Gemini STT: length of each audio piece
# AUDIO_OVERLAP_SECONDS=10

# Long transcripts (sizes in characters, ~4 per token)
# SINGLE_PASS_MAX_CHARS=60000
# CHUNK_MAX_CHARS=24000
# REDUCE_MAX_CHARS=40000
# MAP_CONCURRENCY=4             # parallel Gemini calls in the map step

# Critic agent
# MAX_REVISIONS=2
# TIMESTAMP_TOLERANCE_SECONDS=60

# Where transcripts are cached
# AVS_CACHE_DIR=.cache
